{
  "name": "portfolio",
  "private": true,
  "description": "ARCHIVE.SYS: Haralambos Varsamis's portfolio, a static site served by GitHub Pages from docs/",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "watch": "node tools/build.mjs --watch",
    "check": "node tools/build.mjs --check",
    "serve": "node tools/serve.mjs",
    "qa": "node tests/qa.mjs",
    "format": "prettier --write \"src/**/*.{js,css}\" \"tools/*.mjs\" \"tests/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{js,css}\" \"tools/*.mjs\" \"tests/*.mjs\""
  },
  "devDependencies": {
    "playwright": "1.49.1",
    "prettier": "3.3.3"
  }
}
